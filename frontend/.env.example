# Where the Python harness core is listening.
# Copy this file to .env.local for local development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Postgres. Same database the backend uses. NOT NEXT_PUBLIC_ — it must stay
# server-side. drizzle-kit reads it via the dotenv call in drizzle.config.ts.
DATABASE_URL=

# Encrypts credential tokens (AES-256-GCM) before they are written to Postgres.
# Base64 of 32 random bytes — generate one with:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# This MUST be the same value as CREDENTIALS_ENCRYPTION_KEY in backend/.env:
# Next.js encrypts tokens and the Python harness decrypts them. Changing it
# makes every stored token undecryptable — the only recovery is deleting the
# credentials and adding them again.
CREDENTIALS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Mock mode
#
# `true` makes that surface render fixture data only — the real backend
# (Postgres or the Python harness) is never contacted. Useful for working on
# the UI with nothing else running.
#
# These are NEXT_PUBLIC_, so they are inlined at BUILD time: restart
# `next dev` after changing one. A hot reload will not pick it up.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MOCK_ALL=false
NEXT_PUBLIC_MOCK_WORKFLOW=false
NEXT_PUBLIC_MOCK_AGENTS=false
NEXT_PUBLIC_MOCK_SKILLS=false
NEXT_PUBLIC_MOCK_MCP=false
NEXT_PUBLIC_MOCK_TOOLS=false
NEXT_PUBLIC_MOCK_CHAT=false
# Covers both /memory and /memory-insights.
NEXT_PUBLIC_MOCK_MEMORY=false

# The project IDE's chrome. Nothing backs these yet — versions, snapshots,
# ZIP export, preview URLs and container vitals are fixtures — so this stays
# on until each one has a real endpoint behind it.
NEXT_PUBLIC_MOCK_IDE=false
