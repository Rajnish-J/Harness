# Where the Python harness core is listening.
# Copy this file to .env.local for local development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Postgres. Same database the backend uses. NOT NEXT_PUBLIC_ — it must stay
# server-side. drizzle-kit reads it via the dotenv call in drizzle.config.ts.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Mock mode
#
# `true` makes that surface render fixture data only — the real backend
# (Postgres or the Python harness) is never contacted. Useful for working on
# the UI with nothing else running.
#
# These are NEXT_PUBLIC_, so they are inlined at BUILD time: restart
# `next dev` after changing one. A hot reload will not pick it up.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MOCK_ALL=false
NEXT_PUBLIC_MOCK_WORKFLOW=false
NEXT_PUBLIC_MOCK_AGENTS=false
NEXT_PUBLIC_MOCK_SKILLS=false
NEXT_PUBLIC_MOCK_MCP=false
NEXT_PUBLIC_MOCK_TOOLS=false
NEXT_PUBLIC_MOCK_CHAT=false
