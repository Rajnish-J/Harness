# ---------------------------------------------------------------------------
# LLM providers
#
# These are the FALLBACK. Keys registered on the Credentials page (Models tab)
# are stored encrypted in Postgres and win over anything here, which is what
# lets a provider be added without restarting this process — get_settings() is
# lru_cached, so an .env edit needs a restart to be seen.
#
# Nothing here is required. With no key at all the harness still boots; the
# model picker is simply empty until one is registered.
# ---------------------------------------------------------------------------

# The provider a turn falls back to when no registered key covers the requested
# model: anthropic | openai | groq
LLM_PROVIDER=anthropic

# Required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Both needed to use OpenAI from .env — there is no default model, because a
# stale hardcoded id fails at request time with a confusing 404.
OPENAI_API_KEY=
OPENAI_MODEL=

# Same for Groq. Note that most Groq ids are namespaced with a slash, e.g.
# GROQ_MODEL=openai/gpt-oss-120b or llama-3.3-70b-versatile.
GROQ_API_KEY=
GROQ_MODEL=

# Sandbox the file tools are confined to. Relative paths resolve against backend/.
WORKSPACE_ROOT=./workspace

# Safety limits
MAX_AGENT_ITERATIONS=8
MAX_FILE_BYTES=200000

# --- Project commands -------------------------------------------------------
# Used by run_tests / run_lint / run_build / run_typecheck / run_format, and
# reported by project_overview so the agent knows which checks exist before it
# spends a turn finding out. Each is optional: unset means the tool refuses
# with a clear message instead of guessing your framework. Commands run in the
# workspace, or in the project's container when one is attached.
TEST_COMMAND=
LINT_COMMAND=
BUILD_COMMAND=
TYPECHECK_COMMAND=
# Rewrites files in place -- check git_diff after the agent runs it.
FORMAT_COMMAND=

# --- Web access -------------------------------------------------------------
# The agent's only route off this machine. Off by default; turning it on is a
# deliberate choice, not a default someone inherits. Even when true, private,
# loopback, link-local and cloud-metadata addresses are always refused.
WEB_TOOLS_ENABLED=false
WEB_TIMEOUT_SECONDS=15
WEB_MAX_RESPONSE_BYTES=2000000
# Comma-separated. When set, these are the ONLY reachable hosts (subdomains
# included). Empty means any public host.
WEB_ALLOWED_DOMAINS=
# none | brave | tavily. web_search refuses unless a provider and key are set;
# scraping a search engine's HTML instead would be brittle and against its terms.
WEB_SEARCH_PROVIDER=none
WEB_SEARCH_API_KEY=

# Comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# Postgres, shared with the Next.js app. Optional: with it unset, chat still
# works and every /api/workflows/* route returns 503 instead of crashing.
# The backend runs LangGraph's checkpointer setup() on boot, which creates four
# checkpoint* tables. All other tables are owned by Drizzle (frontend/db).
DATABASE_URL=

# Workflow limits
MAX_WORKFLOW_NODES=50
MAX_WORKFLOW_SUPERSTEPS=50
MAX_NODE_OUTPUT_CHARS=20000
MAX_INTERPOLATED_CHARS=8000

# --- MCP --------------------------------------------------------------------
# true returns plausible fake tools instead of connecting anything. No
# subprocess is spawned, so this is how to work without Node installed.
MOCK_MCP=false
# Off by default: the tool list is part of the prompt, so auto-attaching every
# configured server would silently inflate the cost of every chat.
MCP_ATTACH_ALL_ENABLED=false
MCP_CONNECT_TIMEOUT=20
MCP_LIST_TIMEOUT=15
MCP_TOOL_TIMEOUT=60
MCP_IDLE_TIMEOUT=300
MCP_RETRY_COOLDOWN=30

# Ceiling on the composed system prompt (base + agent + attached skills).
MAX_SYSTEM_PROMPT_CHARS=120000

# --- Tool router ------------------------------------------------------------
# One cheap call before each turn picks which tools that message needs, because
# the whole tool list is serialized into every request. See
# backend/app/agent/tools/router.py.
TOOL_ROUTER_ENABLED=true
# Which model does the choosing. Unset reuses the turn's own model, which always
# works but spends the tokens the router exists to save -- name a cheap, fast
# one here. If the model named is unusable the turn is NOT routed (and says so),
# rather than silently falling back to the expensive one.
# TOOL_ROUTER_MODEL=claude-haiku-4-5-20251001
# Toolsets at or under this are used whole: below it, a round trip to be told
# "keep all six" costs more than it saves.
TOOL_ROUTER_THRESHOLD=25
# A ceiling on the router's picks. read_file, list_directory and search_files
# are added on top and are never trimmed to honour it.
TOOL_ROUTER_MAX_TOOLS=12
TOOL_ROUTER_TIMEOUT=20

# --- Credentials ------------------------------------------------------------
# Decrypts the personal access tokens stored in the `credentials` table.
# Base64 of 32 random bytes, and it MUST match CREDENTIALS_ENCRYPTION_KEY in
# frontend/.env.local: Next.js encrypts tokens, this side decrypts them to call
# GitHub. Generate one with:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Optional, like DATABASE_URL: chat works without it and the credential
# endpoints return 503 rather than the server refusing to boot.
CREDENTIALS_ENCRYPTION_KEY=
