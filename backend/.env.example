# Which provider the agent loop talks to: anthropic | openai
LLM_PROVIDER=anthropic

# Required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Required when LLM_PROVIDER=openai (both of them — there is no default model,
# because a stale hardcoded id fails at request time with a confusing 404)
OPENAI_API_KEY=
OPENAI_MODEL=

# Sandbox the file tools are confined to. Relative paths resolve against backend/.
WORKSPACE_ROOT=./workspace

# Safety limits
MAX_AGENT_ITERATIONS=8
MAX_FILE_BYTES=200000

# Comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# Postgres, shared with the Next.js app. Optional: with it unset, chat still
# works and every /api/workflows/* route returns 503 instead of crashing.
# The backend runs LangGraph's checkpointer setup() on boot, which creates four
# checkpoint* tables. All other tables are owned by Drizzle (frontend/db).
DATABASE_URL=

# Workflow limits
MAX_WORKFLOW_NODES=50
MAX_WORKFLOW_SUPERSTEPS=50
MAX_NODE_OUTPUT_CHARS=20000
MAX_INTERPOLATED_CHARS=8000

# --- MCP --------------------------------------------------------------------
# true returns plausible fake tools instead of connecting anything. No
# subprocess is spawned, so this is how to work without Node installed.
MOCK_MCP=false
# Off by default: the tool list is part of the prompt, so auto-attaching every
# configured server would silently inflate the cost of every chat.
MCP_ATTACH_ALL_ENABLED=false
MCP_CONNECT_TIMEOUT=20
MCP_LIST_TIMEOUT=15
MCP_TOOL_TIMEOUT=60
MCP_IDLE_TIMEOUT=300
MCP_RETRY_COOLDOWN=30

# Ceiling on the composed system prompt (base + agent + attached skills).
MAX_SYSTEM_PROMPT_CHARS=120000
